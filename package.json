{
  "name": "instagram-feed-blocker",
  "version": "0.0.1",
  "description": "Block Instagram's most distracting features.",
  "keywords": [
    "instagram",
    "browser-extension",
    "chrome-extension",
    "firefox-addon",
    "zen-browser",
    "attention",
    "blocking",
    "productivity",
    "feed-control"
  ],
  "author": "shbernal",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:firefox": "EXT_TARGET=firefox pnpm run build",
    "icons": "node scripts/generate-icons.mjs",
    "dev:chrome": "tsc -b && vite build && node scripts/open-chromium.mjs",
    "dev:firefox": "pnpm run build:firefox && node scripts/open-gecko.mjs",
    "dev:zen": "FIREFOX_BINARY=${FIREFOX_BINARY:-/usr/bin/zen-browser} pnpm run dev:firefox",
    "inspect:chrome": "tsc -b && vite build && node scripts/inspect-chromium.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:firefox": "pnpm run build:firefox && web-ext lint --source-dir dist-firefox",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "tsc -b && vite build && playwright test",
    "e2e:headed": "tsc -b && vite build && playwright test --headed",
    "e2e:ui": "tsc -b && vite build && playwright test --ui",
    "e2e:real:setup": "tsc -b && playwright test -c playwright.real.config.ts --grep @setup --headed",
    "e2e:real": "tsc -b && vite build && RUN_REAL_INSTAGRAM_E2E=1 playwright test -c playwright.real.config.ts --grep-invert @setup --headed",
    "e2e:real:open": "node scripts/open-real-instagram.mjs",
    "manual:instagram": "tsc -b && vite build && playwright test -c playwright.manual.config.ts --headed",
    "e2e:real:open:extension": "tsc -b && vite build && INSTAGRAM_REAL_OPEN_EXTENSION=1 node scripts/open-real-instagram.mjs",
    "format": "oxfmt --check .",
    "format:write": "oxfmt .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.1.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.1",
    "web-ext": "^10.6.0"
  }
}
